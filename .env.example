# Copy to .env.local for local development; set the same variables in Netlify for production.

# Team login (server-side). Required as soon as a shared database is configured.
# TEAM_PASSWORD: the one shared team password (at least 10 characters).
# SESSION_SECRET: random string of at least 32 characters, e.g. `openssl rand -hex 32`.
TEAM_PASSWORD=
SESSION_SECRET=

# Shared manual entries from the briefing on / (one database).
# Apply the schema with: npm run db:manual:apply
MANUAL_ENTRIES_DATABASE_URL=

# Dedicated database for official ČSÚ results only (a different database, never the manual one).
# Apply the schema with: npm run db:official:apply ; run the importer with: npm run import:official
OFFICIAL_RESULTS_DATABASE_URL=
